{
  "schemaVersion": 3,
  "characterMode": "flavor-monster",
  "id": "pink-green-flavor-monster-v3",
  "displayName": "粉绿风味小怪兽",
  "canvas": { "width": 384, "height": 384 },
  "anchor": { "x": 192, "y": 344 },
  "hitbox": { "alphaThreshold": 24, "bounds": { "x": 20, "y": 18, "width": 344, "height": 346 } },
  "palette": ["#efb0bd", "#b9cf62", "#151515"],
  "defaultScale": 0.6,
  "floorMode": "work-area",
  "cadence": {
    "idleIntervalMs": [24000, 36000],
    "ambientIntervalMs": [15000, 25000],
    "postEpisodeQuietMs": 6000,
    "pointerDwellMs": 2000,
    "pointerCooldownMs": 60000,
    "dragThresholdPx": 8,
    "pointerResetsSleep": false,
    "profileMultipliers": { "quiet": 1.3, "balanced": 1, "lively": 0.8 }
  },
  "bindings": {
    "idle": "awake-story",
    "ambient": [
      { "behavior": "explore-walk", "weight": 1, "cooldownMs": 140000 },
      { "behavior": "fruit-hiccup", "weight": 1, "cooldownMs": 60000 }
    ],
    "sleep": { "behavior": "sleep-cycle", "afterMs": 120000, "wakeAfterMs": [45000, 90000] },
    "click": "affection-click",
    "pointer": "cursor-encounter",
    "drag": "held",
    "release": "drop-recover"
  },
  "behaviors": {
    "awake-story": { "phases": [
      { "id": "story", "file": "animations/awake-story/story.webp", "frames": 8, "durationsMs": [520, 460, 480, 480, 520, 500, 600, 700], "playback": "once", "completeOn": "animation-finished", "mirrorable": false, "grounding": "floor" }
    ] },
    "explore-walk": { "phases": [
      { "id": "start", "file": "animations/explore-walk/start.webp", "frames": 2, "durationsMs": [450, 500], "playback": "once", "completeOn": "animation-finished", "mirrorable": true, "grounding": "floor" },
      { "id": "walk-loop", "file": "animations/explore-walk/walk-loop.webp", "frames": 4, "durationsMs": [360, 360, 420, 360], "playback": "loop", "completeOn": "motion-finished", "motion": "walk", "mirrorable": true, "grounding": "floor" },
      { "id": "stop", "file": "animations/explore-walk/stop.webp", "frames": 3, "durationsMs": [500, 600, 750], "playback": "once", "completeOn": "animation-finished", "mirrorable": true, "grounding": "floor" }
    ] },
    "sleep-cycle": { "phases": [
      { "id": "sleep-enter", "file": "animations/sleep-cycle/sleep-enter.webp", "frames": 4, "durationsMs": [650, 650, 800, 1200], "playback": "once", "completeOn": "animation-finished", "mirrorable": false, "grounding": "floor" },
      { "id": "sleeping-loop", "file": "animations/sleep-cycle/sleeping-loop.webp", "frames": 3, "durationsMs": [1100, 1000, 1100], "playback": "loop", "completeOn": "wake-requested", "mirrorable": false, "grounding": "floor" },
      { "id": "wake-exit", "file": "animations/sleep-cycle/wake-exit.webp", "frames": 3, "durationsMs": [550, 650, 800], "playback": "once", "completeOn": "animation-finished", "mirrorable": false, "grounding": "floor" }
    ] },
    "affection-click": { "phases": [
      { "id": "response", "file": "animations/affection-click/response.webp", "frames": 8, "durationsMs": [500, 480, 520, 600, 850, 600, 600, 800], "playback": "once", "completeOn": "animation-finished", "mirrorable": false, "grounding": "floor" }
    ] },
    "cursor-encounter": { "phases": [
      { "id": "notice", "file": "animations/cursor-encounter/notice.webp", "frames": 3, "durationsMs": [550, 500, 550], "playback": "once", "completeOn": "animation-finished", "mirrorable": false, "grounding": "floor" },
      { "id": "approach", "file": "animations/cursor-encounter/approach.webp", "frames": 3, "durationsMs": [400, 380, 420], "playback": "loop", "completeOn": "motion-finished", "motion": "cursor-approach", "mirrorable": true, "grounding": "floor" },
      { "id": "touch", "file": "animations/cursor-encounter/touch.webp", "frames": 1, "durationsMs": [800], "playback": "once", "completeOn": "animation-finished", "mirrorable": false, "grounding": "floor" },
      { "id": "retreat", "file": "animations/cursor-encounter/retreat.webp", "frames": 1, "durationsMs": [420], "playback": "loop", "completeOn": "motion-finished", "motion": "cursor-return", "mirrorable": true, "grounding": "floor" },
      { "id": "settle", "file": "animations/cursor-encounter/settle.webp", "frames": 1, "durationsMs": [700], "playback": "once", "completeOn": "animation-finished", "mirrorable": false, "grounding": "floor" }
    ] },
    "held": { "phases": [
      { "id": "grab-enter", "file": "animations/held/grab-enter.webp", "frames": 4, "durationsMs": [500, 450, 500, 650], "playback": "once", "completeOn": "animation-finished", "mirrorable": false, "grounding": "free" },
      { "id": "held-loop", "file": "animations/held/held-loop.webp", "frames": 3, "durationsMs": [700, 700, 700], "playback": "loop", "completeOn": "pointer-released", "mirrorable": false, "grounding": "free" }
    ] },
    "drop-recover": { "phases": [
      { "id": "fall-loop", "file": "animations/drop-recover/fall-loop.webp", "frames": 4, "durationsMs": [320, 320, 320, 320], "playback": "loop", "completeOn": "floor-impact", "motion": "fall", "mirrorable": false, "grounding": "free" },
      { "id": "impact", "file": "animations/drop-recover/impact.webp", "frames": 1, "durationsMs": [650], "playback": "once", "completeOn": "animation-finished", "mirrorable": false, "grounding": "floor" },
      { "id": "rebound", "file": "animations/drop-recover/rebound.webp", "frames": 1, "durationsMs": [450], "playback": "once", "completeOn": "animation-finished", "mirrorable": false, "grounding": "floor" },
      { "id": "settle", "file": "animations/drop-recover/settle.webp", "frames": 2, "durationsMs": [600, 800], "playback": "once", "completeOn": "animation-finished", "mirrorable": false, "grounding": "floor" }
    ] },
    "fruit-hiccup": { "phases": [
      { "id": "hiccup", "file": "animations/fruit-hiccup/hiccup.webp", "frames": 8, "durationsMs": [520, 480, 500, 600, 850, 600, 650, 800], "playback": "once", "completeOn": "animation-finished", "mirrorable": false, "grounding": "floor" }
    ] }
  }
}
